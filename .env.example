# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (never prefix with NEXT_PUBLIC_). Needed for payments, webhooks and refunds.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments: "mock" uses GroupFly's built-in test payment page (no account needed).
# "razorpay" uses Razorpay test mode; live keys (rzp_live_...) are refused.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
